    "from pathlib import Path\n",
    "import requests\n",
    "import pandas as pd\n",
    "import geopandas as gpd\n",
    "\n",
    "ROOT = Path.cwd()\n",
    "RAW = ROOT / 'data' / 'raw'\n",
    "BOUNDARIES = ROOT / 'data' / 'boundaries'\n",
    "OUT = ROOT / 'outputs'\n",
    "BOUNDARIES.mkdir(exist_ok=True)\n",
    "OUT.mkdir(exist_ok=True)"
   ]
  },
